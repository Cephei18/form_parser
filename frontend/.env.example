# Synchronous EC2 / FastAPI backend (OCR rule/ml + Textract fallback). Unchanged.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Async serverless Textract API (API Gateway). Additive — only used when the
# flag below is "true" and the selected mode is Textract. MUST include the /dev
# stage; the async client appends /uploads, /jobs/{id}, /result/{id}.
NEXT_PUBLIC_ASYNC_API_BASE_URL=https://58is64i9kb.execute-api.ap-south-1.amazonaws.com/dev

# Master switch for the async Textract flow. "false" keeps 100% of traffic on
# the synchronous EC2 path (instant rollback, no infra teardown).
NEXT_PUBLIC_TEXTRACT_ASYNC=false
