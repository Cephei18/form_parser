# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/

# Logs
*.log

# Environment variables
.env
.env.*

# IDE / editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Frontend generated artifacts
frontend/node_modules/
frontend/.next/

# Large/generated files
output/
uploads/
/experiments/textract_eval/

# Experiment artifacts (raw API responses, annotated PDFs, outputs)
/experiments/**/output/
/experiments/**/*.raw.json
/experiments/**/*.summary.json
/experiments/**/*.textract_annotated.pdf

# AWS and secret files (catch common accidental filenames)
aws_credentials
aws_credentials.json
credentials.json
secrets.json
*.pem
*.key
*.crt
*.p12
.aws/
.env.local
*.secret
