# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
.hypothesis/
.tox/
.nox/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Python tooling
.python-version
.cache/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/
*.tsbuildinfo

# Logs
*.log

# Environment variables (ignore real env files, keep committable templates)
.env
.env.*
!.env.example
!frontend/.env.example

# IDE / editor
.vscode/
.idea/
.claude/

# OS files
.DS_Store
Thumbs.db

# Editor backups / swap / merge artifacts
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# Frontend generated artifacts
frontend/node_modules/
frontend/.next/
frontend/.next_dev/
frontend/.next-rollback/
frontend/out/
# Pre-deploy snapshot of the live frontend bucket (rollback artifact, not source)
frontend-prod-backup/

# Large/generated files
output/
uploads/
tmp/
temp/
# Evaluation harness run outputs (generated)
eval_runs/
# Offline replay outputs (dashboard + visualizations, regenerated on demand)
replay_out/
benchmarks/corpus/*/replay/
# Benchmark corpus: commit ONLY the annotation scaffold (ground_truth.json,
# notes.md) + manifest/README/template/synthetic example. NEVER push real form
# data (PII risk) or regenerable pipeline output — all reproducible from a
# cached Textract response that is itself kept out of the repo.
benchmarks/corpus/*/input.*
benchmarks/corpus/*/artifacts/
benchmarks/corpus/*/textract_raw_response.json
benchmarks/corpus/*/mappings.json
benchmarks/corpus/*/benchmark_summary.json
benchmarks/corpus/*/dashboard.html
input/*.pdf
input/*.png
input/*.jpg
input/*.jpeg
response.json
/experiments/textract_eval/

# Experiment artifacts (raw API responses, annotated PDFs, outputs)
/experiments/**/output/
/experiments/**/*.raw.json
/experiments/**/*.summary.json
/experiments/**/*.textract_annotated.pdf

# AWS and secret files (catch common accidental filenames)
aws_credentials
aws_credentials.json
credentials.json
secrets.json
*.pem
*.key
*.crt
*.p12
.aws/
.env.local
*.secret
# Extra secret-bearing patterns (env files in any name, SSH keys, IaC vars, netrc)
*.env
.netrc
id_rsa
id_rsa.*
*.ppk
*.tfvars
*.keystore
*.jks

# Serverless / Lambda deployment local outputs
# Keep ignore patterns on their own lines.
# out.json: `aws lambda invoke` output produced by the deploy runbook
out.json
*.lambda-invoke.json
# downloaded / packaged Lambda zip bundles (tracked source files are not .zip)
*.zip
