# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/
*.tsbuildinfo

# Logs
*.log

# Environment variables (ignore real env files, keep committable templates)
.env
.env.*
!.env.example
!frontend/.env.example

# IDE / editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Frontend generated artifacts
frontend/node_modules/
frontend/.next/
frontend/.next_dev/
frontend/.next-rollback/
frontend/out/
# Pre-deploy snapshot of the live frontend bucket (rollback artifact, not source)
frontend-prod-backup/

# Large/generated files
output/
uploads/
tmp/
temp/
input/*.pdf
input/*.png
input/*.jpg
input/*.jpeg
response.json
/experiments/textract_eval/

# Experiment artifacts (raw API responses, annotated PDFs, outputs)
/experiments/**/output/
/experiments/**/*.raw.json
/experiments/**/*.summary.json
/experiments/**/*.textract_annotated.pdf

# AWS and secret files (catch common accidental filenames)
aws_credentials
aws_credentials.json
credentials.json
secrets.json
*.pem
*.key
*.crt
*.p12
.aws/
.env.local
*.secret

# Serverless / Lambda deployment local outputs
# (gitignore has no inline comments — keep patterns on their own lines)
# out.json: `aws lambda invoke` output produced by the deploy runbook
out.json
*.lambda-invoke.json
# downloaded / packaged Lambda zip bundles (tracked source files are not .zip)
*.zip
