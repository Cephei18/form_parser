{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TextractAnalyzeSync",
      "Effect": "Allow",
      "Action": ["textract:AnalyzeDocument"],
      "Resource": "*"
    },
    {
      "Sid": "TextractAnalyzeAsync",
      "Effect": "Allow",
      "Action": [
        "textract:StartDocumentAnalysis",
        "textract:GetDocumentAnalysis"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RawDocumentsRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::form-pdf-poc-dev-raw-documents/*"
    },
    {
      "Sid": "ProcessedDocumentsWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::form-pdf-poc-dev-processed-documents/*"
    }
  ]
}
